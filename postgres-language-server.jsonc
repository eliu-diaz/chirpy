{
  "$schema": "https://pg-language-server.com/0.26.0/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      // goose "Down" migrations drop tables on purpose
      "safety": { "banDropTable": "off" }
    }
  },
  "format": {
    "enabled": true,
    "keywordCase": "upper",
    "typeCase": "upper",
    "constantCase": "upper"
  },
  "typecheck": { "enabled": true },
  // local dev database (trust auth, no password)
  "db": {
    "host": "127.0.0.1",
    "port": 5432,
    "username": "eliu",
    "password": "",
    "database": "chirpy",
    "connTimeoutSecs": 10
  }
}
